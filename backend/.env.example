# Server Port
PORT=5000

# Optional: GitHub Personal Access Token to increase rate limit from 60 to 5,000 requests/hr
# Format: ghp_... or github_pat_...
GITHUB_TOKEN=

# Optional: Google Gemini API Key for AI profile generation
# Get one for free at https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6LgYfjP2GCpeej9GslNfUE3HFF16gjiMQS20JZeqjpoBA

# Optional: OpenAI API Key or compatible endpoint (if using OpenAI instead)
OPENAI_API_KEY=

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL=600
